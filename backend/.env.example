# =============================================================
# SangamX Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER expose these variables to the frontend.
# =============================================================

# -------------------------------------------------------------
# PROVIDER API KEYS  (free tier only — zero paid spending)
# -------------------------------------------------------------

# Google Gemini (primary)  — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (secondary, fast free tier) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# -------------------------------------------------------------
# OLLAMA (local fallback — no API key required)
# Install: https://ollama.com
# Start:   ollama serve
# Pull:    ollama pull qwen3:4b
# -------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Max concurrent local inference requests (tune for 16 GB RAM + GPU)
# 2 is safe; increase to 3–4 if GPU VRAM allows
OLLAMA_MAX_CONCURRENCY=2

# -------------------------------------------------------------
# PER-AGENT PROVIDER + MODEL CONFIGURATION
# Provider choices: gemini | groq | ollama
# -------------------------------------------------------------

# Planner — decomposes query into structured plan
PLANNER_PROVIDER=gemini
PLANNER_MODEL=gemini-2.0-flash-exp

# Researcher — broad knowledge retrieval
RESEARCHER_PROVIDER=gemini
RESEARCHER_MODEL=gemini-2.0-flash-exp

# Analyst — deep technical analysis
ANALYST_PROVIDER=gemini
ANALYST_MODEL=gemini-2.0-flash-exp

# Critic — compares outputs for disagreement (fast model preferred)
CRITIC_PROVIDER=groq
CRITIC_MODEL=llama-3.1-8b-instant

# Synthesizer — final answer generation
SYNTHESIZER_PROVIDER=gemini
SYNTHESIZER_MODEL=gemini-2.0-flash-exp

# -------------------------------------------------------------
# PROVIDER BEHAVIOUR
# -------------------------------------------------------------

# Seconds before a single LLM call times out
LLM_TIMEOUT=60.0

# Max retries per cloud provider before Ollama fallback kicks in
PROVIDER_MAX_RETRIES=2

# -------------------------------------------------------------
# SERVER
# -------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# -------------------------------------------------------------
# FREE-TIER LIMITS (documented for reference — not read by app)
# -------------------------------------------------------------
# Gemini 2.0 Flash Experimental: 10 req/min, 1500 req/day
# Groq llama-3.1-8b-instant:     30 req/min, 14400 req/day
# Ollama: unlimited (local hardware only)
